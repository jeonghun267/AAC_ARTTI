# 이 파일을 복사해 프로젝트 루트에 .env로 저장하고 값을 채운다. (.env는 gitignore 대상이라 커밋되지 않음)
# 빌드 전 Unity 메뉴 Artti > Copy .env to Resources 로 기기용 키 파일을 만든다.

# 훈련모드 (Gemini 대화, 음성)
GEMINI_API_KEY=
GOOGLE_STT_API_KEY=
GOOGLE_TTS_API_KEY=

# 서버PC STT (선택)
STT_SERVER_URL=
STT_SERVER_API_KEY=
STT_SERVER_MODEL=

# AR현장모드 장소 검색
KAKAO_REST_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
