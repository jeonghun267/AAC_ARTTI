        { "id": "promo_subflow",    "trigger": "사용자가 행사 상품 언급 (예: 1+1 있어요?)",        "handling": "단순 정보 제공 후 메인 흐름 복귀" }
      ],
      "fallbacks": [
        { "condition": "llm_call_failed",    "action": "NPC가 정중하게 안내 응답 후 같은 turn 재시도" },
        { "condition": "turn_limit_reached", "action": "결제 완료 후 종료. items_requested에 최소 1개 항목 보장" }
      ]
    }
  ]
