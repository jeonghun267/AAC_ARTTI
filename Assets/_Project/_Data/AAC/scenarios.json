      "slots": [
        { "key": "items_requested",   "type": "string[]", "description": "사용자가 찾는/요청한 물건" },
        { "key": "location_asked_for","type": "string",   "description": "위치 문의한 물건" },
        { "key": "payment_method",    "type": "string",   "description": "card 또는 cash" },
        { "key": "bag_needed",        "type": "boolean",  "description": "봉투 필요 여부" }
      ],
      "subflows": [
