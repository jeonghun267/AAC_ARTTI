  m_text: "\u2022 \uC67C\uCABD \uB9D0\uD48D\uC120\uC744 \uB204\uB974\uBA74 \uADF8
    \uBB38\uC7A5\uC73C\uB85C \uC810\uC6D0\uC5D0\uAC8C \uB9D0\uD574\uC694.\n\u2022
    \uC624\uB978\uCABD \uB300\uD654 \uD78C\uD2B8\uB97C \uB204\uB974\uBA74 \uB9DE\uB294
    \uBB38\uC7A5\uC774 \uC67C\uCABD \uB9E8 \uC704\uC5D0 \uB098\uC640\uC694.\n\u2022
    \u2018\uC9C0\uAE08 \uB9D0\uD574\uBCF4\uC138\uC694\u2019\uB97C \uB204\uB974\uACE0
    \uC9C1\uC811 \uB9D0\uD558\uAC70\uB098,\n   \u2018\uD0A4\uBCF4\uB4DC \uC785\uB825\u2019\uC73C\uB85C
    \uC368\uC11C \uBCF4\uB0BC \uC218 \uC788\uC5B4\uC694.\n\u2022 \uCD94\uCC9C \uC0C1\uD488\uC744
    \uB204\uB974\uBA74 \uADF8 \uBB3C\uAC74\uC744 \uB2EC\uB77C\uACE0 \uB9D0\uD574\uC694."
