  m_EditorClassIdentifier: Assembly-CSharp::Artti.UI.TrainingOnboardingView
  root: {fileID: 1224847926}
  dimTop: {fileID: 2002389615}
  dimBottom: {fileID: 2105199549}
  dimLeft: {fileID: 1635154580}
  dimRight: {fileID: 1761264625}
  frame: {fileID: 2144255114}
