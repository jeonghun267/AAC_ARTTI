  - {fileID: 1090051999}
  - {fileID: 1726569756}
  - {fileID: 1896413215}
  - {fileID: 776844781}
  accuracyTexts:
  - "\uC810\uC6D0\uC774 \uD558\uB294 \uB9D0\uC774 \uC5EC\uAE30\uC5D0 \uB098\uC640\uC694.\n\uB9D0\uD48D\uC120\uC744
    \uB204\uB974\uBA74 \uB2E4\uC2DC \uB4E4\uC744 \uC218 \uC788\uC5B4\uC694."
  - "\uC774 \uBC84\uD2BC\uC744 \uB204\uB974\uACE0 \uB610\uBC15\uB610\uBC15 \uB9D0\uD574
    \uBCF4\uC138\uC694.\n\uC798 \uC548 \uB4E4\uB9AC\uBA74 \uC810\uC6D0\uC774 \uB2E4\uC2DC
    \uB9D0\uD574 \uB2EC\uB77C\uACE0 \uD574\uC694."
  - "\uB9D0\uD558\uAE30 \uC5B4\uB824\uC6B0\uBA74 \uC774 \uBB38\uC7A5\uC744 \uB20C\uB7EC\uB3C4
    \uB3FC\uC694.\n\uBE5B\uB098\uB294 \uBB38\uC7A5\uC774 \uC9C0\uAE08 \uD558\uBA74
    \uC88B\uC740 \uB9D0\uC774\uC5D0\uC694."
  - "\uD558\uACE0 \uC2F6\uC740 \uB9D0\uC758 \uC885\uB958\uB97C \uB204\uB974\uBA74\n\uB9DE\uB294
    \uBB38\uC7A5\uC774 \uC67C\uCABD \uB9E8 \uC704\uC5D0 \uB098\uC640\uC694."
  - "\uC0C1\uD488\uC744 \uB204\uB974\uBA74 \uADF8 \uBB3C\uAC74\uC744 \uB2EC\uB77C\uACE0
    \uB9D0\uD574\uC694.\n\uD654\uC0B4\uD45C\uB85C \uB2E4\uB978 \uC0C1\uD488\uB3C4
    \uBCFC \uC218 \uC788\uC5B4\uC694."
  - "\uC9C0\uAE08 \uD574\uC57C \uD560 \uC77C\uC774 \uC5EC\uAE30\uC5D0 \uB098\uC640\uC694.\n\uD55C
    \uB2E8\uACC4\uC529 \uD574\uB0BC \uB54C\uB9C8\uB2E4 \uBC30\uAC00 \uB2E4\uC74C
    \uBCC4\uB85C \uB098\uC544\uAC00\uC694."
  - "\uB9D0 \uB300\uC2E0 \uAE00\uC790\uB85C \uC368\uC11C\n\uC810\uC6D0\uC5D0\uAC8C
    \uBCF4\uB0BC \uC218 \uC788\uC5B4\uC694."
  - "\uD604\uC7A5\uBAA8\uB4DC\uB85C \uAC00\uBA74 \uC2E4\uC81C \uAC00\uAC8C\uC5D0\uC11C\n\uCE74\uBA54\uB77C\uB85C
    \uAC04\uD310\uC744 \uBE44\uCDB0 \uBCFC \uC218 \uC788\uC5B4\uC694."
  - "\uC774 \uC124\uBA85\uC740 \u2018\uB3C4\uC6C0\uB9D0\u2019\uC744 \uB204\uB974\uBA74
    \uB2E4\uC2DC \uBCFC \uC218 \uC788\uC5B4\uC694.\n\u2018\uB098\uAC00\uAE30\u2019\uB97C
    \uB204\uB974\uBA74 \uD6C8\uB828\uC744 \uB9C8\uCCD0\uC694."
  conversationTexts:
  - 
  - "\uC774 \uBC84\uD2BC\uC744 \uB204\uB974\uACE0 \uD3B8\uD558\uAC8C \uB9D0\uD574
    \uBCF4\uC138\uC694.\n\uC870\uAE08 \uD2C0\uB824\uB3C4 \uC810\uC6D0\uC774 \uC54C\uC544\uB4E4\uC5B4\uC694."
  - "\uC774 \uBB38\uC7A5\uC744 \uB204\uB974\uBA74 \uC810\uC6D0\uC5D0\uAC8C \uB300\uC2E0
    \uB9D0\uD574 \uC918\uC694.\n\uBE5B\uB098\uB294 \uBB38\uC7A5\uC774 \uC9C0\uAE08
    \uD558\uBA74 \uC88B\uC740 \uB9D0\uC774\uC5D0\uC694."
